.datos
    origen:
        definir_vectflot 1.0, 2.0, 3.0, 4.0
    destino:
        reservar_vectflot 4

.codigo
inicio:
    # Paso 1: LEA dirección de origen → r_puntero64
    cargar_direccion origen, r_puntero64
    # Paso 2: acceso indirecto → ahora la base SÍ es un registro
    cargar_vector [r_puntero64], xmm0_128

    # Paso 1: LEA dirección de destino → r_puntero64
    cargar_direccion destino, r_puntero64
    # Paso 2: guardar vía registro base
    guardar_vector xmm0_128, [r_puntero64]

    terminar