.datos
buffer:
reservar_byte 10

.codigo
inicio:
    cargar_direccion buffer, r_puntero64

    # ==========================================
    # PRUEBA 1: 'O' (8 bits especial -> 64 bits)
    # ==========================================
    copiar 79, r12_8          # r12_8 = 79
    copiar r12_8, r_acumulador64 # Extensión a 64 bits
    guardar_byte_puntero r_acumulador64, [r_puntero64]
    sumar 1, r_puntero64

    # ==========================================
    # PRUEBA 2: 'K' (16 bits especial -> 32 bits -> 64 bits)
    # ==========================================
    copiar 75, r13_16         # r13_16 = 75
    copiar r13_16, r14_32     # Extensión a 32 bits
    copiar r14_32, r_acumulador64 # Extensión a 64 bits
    guardar_byte_puntero r_acumulador64, [r_puntero64]
    sumar 1, r_puntero64

    # ==========================================
    # PRUEBA 3: '!' (32 bits especial -> 16 clásico -> 8 clásico -> 64 bits)
    # ==========================================
    copiar 33, r15_32         # r15_32 = 33
    copiar r15_32, r_base16   # Truncamiento a 16 bits (BX)
    copiar r_base16, r_destino8 # Truncamiento a 8 bits (DIL)
    copiar r_destino8, r_acumulador64 # Extensión a 64 bits
    guardar_byte_puntero r_acumulador64, [r_puntero64]
    sumar 1, r_puntero64

    # ==========================================
    # PRUEBA 4: 'A' (64 bits especial -> 32 -> 16 -> 8 -> 64 bits)
    # ==========================================
    # 321 en hexadecimal es 0x141. El último byte es 0x41 ('A').
    copiar 321, r8_64         # r8_64 = 321
    copiar r8_64, r9_32       # Truncamiento 64->32
    copiar r9_32, r10_16      # Truncamiento 32->16
    copiar r10_16, r11_8      # Truncamiento 16->8 (se queda con 0x41)
    copiar r11_8, r_acumulador64 # Extensión 8->64
    guardar_byte_puntero r_acumulador64, [r_puntero64]
    sumar 1, r_puntero64

    # ==========================================
    # IMPRIMIR
    # ==========================================
    # Salto de línea
    copiar 10, r_acumulador64
    guardar_byte_puntero r_acumulador64, [r_puntero64]

    # Imprimimos los 5 bytes del buffer ("OK!A\n")
    cargar_direccion buffer, r_puntero64
    copiar 5, r_datos64
    copiar 1, r_acumulador64
    copiar 1, r_destino64
    interrumpir

    terminar